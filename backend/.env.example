# Database Configuration
# PostgreSQL connection string
# Format: postgresql://USERNAME:PASSWORD@HOST:PORT/DATABASE?options
DATABASE_URL="postgresql://user:password@localhost:5432/coffee_lab?schema=public"

# JWT Secret Key
# IMPORTANT: Generate a strong random secret for production
# You can use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:5173"

# Node Environment
NODE_ENV="development"

# Server Port
PORT=3001

# ============================================
# Email Configuration
# ============================================
EMAIL_ENABLED="true"

# Email Service Provider
# Options: "resend", "brevo", "gmail"
EMAIL_SERVICE="brevo"

# Email From Name
EMAIL_FROM_NAME="Coffee Lab"

# ============================================
# Brevo SMTP Configuration
# Get your credentials from: https://app.brevo.com/settings/keys/smtp
# ============================================
BREVO_SMTP_USER="your-brevo-smtp-user"
BREVO_SMTP_PASSWORD="your-brevo-smtp-password"
BREVO_FROM_EMAIL="your-email@example.com"

# ============================================
# Resend Configuration (Alternative)
# Get your API key from: https://resend.com/api-keys
# ============================================
# RESEND_API_KEY="re_your_resend_api_key"
# RESEND_FROM="onboarding@resend.dev"

# ============================================
# Gmail Configuration (Alternative)
# Use Gmail App Password: https://myaccount.google.com/apppasswords
# ============================================
# GMAIL_USER="your-email@gmail.com"
# GMAIL_APP_PASSWORD="your-gmail-app-password"

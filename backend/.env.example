# Database Configuration
DATABASE_URL="postgresql://user:password@host:port/database"

# JWT Secret - MUST be at least 32 characters
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET="your-secure-jwt-secret-here-minimum-32-characters"

# Frontend URL
FRONTEND_URL="http://localhost:5173"

# Environment
NODE_ENV="development"
PORT=3001

# Email Configuration
EMAIL_ENABLED="true"
EMAIL_SERVICE="brevo"
EMAIL_FROM_NAME="Coffee Lab"

# Brevo SMTP (only needed if using email)
BREVO_SMTP_USER="your-smtp-user"
BREVO_SMTP_PASSWORD="your-smtp-password"
BREVO_FROM_EMAIL="your-from-email@example.com"

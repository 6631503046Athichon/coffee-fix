generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                 @id @default(uuid())
  email                String?                @unique
  username             String?                @unique
  password             String
  name                 String
  roles                UserRole[]
  isActive             Boolean                @default(true)
  isSuperAdmin         Boolean                @default(false)
  mustChangePassword   Boolean                @default(true)
  mustChangeUsername   Boolean                @default(false)
  mustChangeEmail      Boolean                @default(false)
  createdAt            DateTime               @default(now())
  updatedAt            DateTime               @updatedAt
  lastLogin            DateTime?
  cuppingSessions      CuppingSession[]       @relation("SessionCreator")
  cuppingJudges        CuppingSessionJudge[]
  createdFarms         Farm[]                 @relation("FarmOwner")
  farmCollaborations   FarmCollaborator[]     @relation("CollaboratorUser")
  gapLogs              GAPLogEntry[]
  greenBeanLots        GreenBeanLot[]         @relation("GreenBeanLotCreator")
  priceSetGreenBeans   GreenBeanLot[]         @relation("PriceSetter")
  withdrawalHistory    GreenBeanWithdrawal[]  @relation("WithdrawalUser")
  parchmentWithdrawals ParchmentWithdrawal[]  @relation("ParchmentWithdrawalUser")
  harvestLots          HarvestLot[]           @relation("HarvestLotCreator")
  invoices             Invoice[]
  judgeScores          JudgeScore[]
  passwordResetTokens  PasswordResetToken[]
  pricingHistory       PricingHistory[]
  processingBatches    ProcessingBatch[]      @relation("ProcessingBatchCreator")
  roastBatches         RoastBatch[]
  roasterInventory     RoasterInventoryItem[]
  saleOrders           SaleOrder[]
  soilAnalyses         SoilAnalysis[]
  weatherRecords       WeatherRecord[]

  @@index([email])
  @@index([username])
  @@index([isActive])
}

model Farm {
  id             String          @id @default(uuid())
  farmName       String
  ownerNames     String[]        @default([])
  location       String
  latitude       Float?
  longitude      Float?
  altitude       String?
  googleMapsUrl  String?
  ownerId        String
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  archived       Boolean         @default(false)
  archivedAt     DateTime?
  caretakerNames String[]        @default([])
  caretakerName  String?
  sizeHectares   Float?
  varieties                String[]
  weatherAutoFetchEnabled  Boolean         @default(false)
  weatherAutoFetchInterval Int             @default(5)
  owner                    User            @relation("FarmOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  collaborators  FarmCollaborator[]
  gapLogs        GAPLogEntry[]
  harvestLots    HarvestLot[]
  soilAnalyses   SoilAnalysis[]
  weatherRecords WeatherRecord[]

  @@index([ownerId])
  @@index([archived])
}

model CropYear {
  id                String            @id @default(uuid())
  year              String            @unique
  startDate         DateTime
  endDate           DateTime
  description       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  harvestLots       HarvestLot[]
  processingBatches ProcessingBatch[]
}

model HarvestLot {
  id                String            @id @default(uuid())
  displayId         String?           @unique
  farmerName        String
  cherryVariety     String
  weightKg          Float
  remainingWeightKg Float?
  farmPlotLocation  String
  harvestDate       DateTime
  status            HarvestLotStatus  @default(ReadyForProcessing)
  cropYearId        String?
  farmId            String?
  createdById       String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  createdBy         User?             @relation("HarvestLotCreator", fields: [createdById], references: [id])
  cropYear          CropYear?         @relation(fields: [cropYearId], references: [id])
  farm              Farm?             @relation(fields: [farmId], references: [id])
  parchmentLots     ParchmentLot[]
  processingBatches ProcessingBatch[]

  @@index([farmId])
  @@index([status])
  @@index([harvestDate])
}

model ProcessingBatch {
  id                String                @id @default(uuid())
  displayId         String?               @unique
  harvestLotId      String
  createdById       String?
  status            ProcessingBatchStatus @default(ToProcess)
  processType       String
  processNotes      String?
  cropYearId        String?
  parchmentWeightKg Float?
  moistureContent   Float?
  baggingDate       DateTime?
  dryingStartDate   DateTime?
  dryingEndDate     DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  dryingLogs        DryingLogEntry[]
  parchmentLots     ParchmentLot[]
  createdBy         User?                 @relation("ProcessingBatchCreator", fields: [createdById], references: [id])
  cropYear          CropYear?             @relation(fields: [cropYearId], references: [id])
  harvestLot        HarvestLot            @relation(fields: [harvestLotId], references: [id], onDelete: Cascade)

  @@index([harvestLotId])
  @@index([status])
}

model DryingLogEntry {
  id                String          @id @default(uuid())
  processingBatchId String
  date              DateTime
  moistureContent   Float
  ambientTemp       Float
  relativeHumidity  Float
  createdAt         DateTime        @default(now())
  processingBatch   ProcessingBatch @relation(fields: [processingBatchId], references: [id], onDelete: Cascade)

  @@index([processingBatchId, date])
}

model PhysicalTestResults {
  id                   String       @id @default(uuid())
  parchmentLotId       String       @unique
  sampleWeightGrams    Float
  greenBeanWeightGrams Float
  greenBeanMoisture    Float
  waterActivity        Float
  density              Float
  defectCount          Int
  notes                String?
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  parchmentLot         ParchmentLot @relation(fields: [parchmentLotId], references: [id], onDelete: Cascade)
}

model ParchmentLot {
  id                  String               @id @default(uuid())
  displayId           String?              @unique
  processingBatchId   String?
  harvestLotId        String?
  sourceType          ParchmentSourceType  @default(Internal)
  externalSource      Json?
  initialWeightKg     Float
  currentWeightKg     Float
  moistureContent     Float
  processType         String
  status              ParchmentLotStatus   @default(AwaitingHulling)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  greenBeanLots       GreenBeanLot[]
  harvestLot          HarvestLot?          @relation(fields: [harvestLotId], references: [id], onDelete: Cascade)
  processingBatch     ProcessingBatch?     @relation(fields: [processingBatchId], references: [id], onDelete: Cascade)
  physicalTestResults PhysicalTestResults?
  withdrawalHistory   ParchmentWithdrawal[]

  @@index([processingBatchId])
  @@index([status])
  @@index([sourceType])
}

model GreenBeanLot {
  id                 String                      @id @default(uuid())
  displayId          String?                     @unique
  sourceType         GreenBeanSourceType
  parchmentLotId     String?
  grade              String
  initialWeightKg    Float
  currentWeightKg    Float
  availabilityStatus GreenBeanAvailabilityStatus @default(Available)
  pricePerKg         Float?
  currency           String?
  priceSetDate       DateTime?
  priceSetBy         String?
  createdById        String?
  externalSource     Json?
  publicTraceId      String?                     @unique
  qrGeneratedAt      DateTime?
  processorScore     Float?
  cuppingFragrance   Float?
  cuppingFlavor      Float?
  cuppingAftertaste  Float?
  cuppingAcidity     Float?
  cuppingBody        Float?
  cuppingBalance     Float?
  cuppingOverall     Float?
  cuppingUniformity  Float?
  cuppingCleanCup    Float?
  cuppingSweetness   Float?
  createdAt          DateTime                    @default(now())
  updatedAt          DateTime                    @updatedAt
  cuppingSamples     CuppingSample[]
  cuppingScores      CuppingScore[]
  createdBy          User?                       @relation("GreenBeanLotCreator", fields: [createdById], references: [id])
  parchmentLot       ParchmentLot?               @relation(fields: [parchmentLotId], references: [id])
  priceSetter        User?                       @relation("PriceSetter", fields: [priceSetBy], references: [id])
  withdrawalHistory  GreenBeanWithdrawal[]
  invoiceItems       InvoiceItem[]
  pricingHistory     PricingHistory[]
  roastBatches       RoastBatch[]
  roasterInventory   RoasterInventoryItem[]
  saleOrderItems     SaleOrderItem[]

  @@index([sourceType])
  @@index([availabilityStatus])
  @@index([parchmentLotId])
}

model GreenBeanWithdrawal {
  id              String         @id @default(uuid())
  greenBeanLotId  String
  amountKg        Float
  withdrawalType  WithdrawalType
  purpose         String
  notes           String?
  date            DateTime       @default(now())
  withdrawnBy     String?
  withdrawnByName String?
  salePrice       Float?
  currency        String?
  customerName    String?
  invoiceNumber   String?
  deliveryAddress String?
  totalAmount     Float?
  createdAt       DateTime       @default(now())
  greenBeanLot    GreenBeanLot   @relation(fields: [greenBeanLotId], references: [id], onDelete: Cascade)
  withdrawnByUser User?          @relation("WithdrawalUser", fields: [withdrawnBy], references: [id])

  @@index([greenBeanLotId])
  @@index([date])
}

model ParchmentWithdrawal {
  id                String                   @id @default(uuid())
  parchmentLotId    String
  amountKg          Float
  withdrawalType    ParchmentWithdrawalType
  purpose           String
  notes             String?
  date              DateTime                 @default(now())
  withdrawnBy       String?
  withdrawnByName   String?
  salePrice         Float?
  currency          String?
  customerName      String?
  deliveryAddress   String?
  totalAmount       Float?
  targetRoasterId   String?
  roastProfileNotes String?
  cuppingScore      Float?
  createdAt         DateTime                 @default(now())
  parchmentLot      ParchmentLot             @relation(fields: [parchmentLotId], references: [id], onDelete: Cascade)
  withdrawnByUser   User?                    @relation("ParchmentWithdrawalUser", fields: [withdrawnBy], references: [id])

  @@index([parchmentLotId])
  @@index([date])
}

model ActivityType {
  id          String        @id @default(uuid())
  name        String        @unique
  description String?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  gapLogs     GAPLogEntry[]

  @@index([isActive])
}

model ProcessType {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  colorScheme Json
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([isActive])
}

model CoffeeVariety {
  id              String   @id @default(uuid())
  name            String   @unique
  species         String
  origin          String?
  description     String?
  characteristics String?
  altitude        String?
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([species])
  @@index([isActive])
}

model GAPLogEntry {
  id               String       @id @default(uuid())
  farmId           String?
  farmPlotLocation String
  activityTypeId   String
  activityTypeName String
  date             DateTime
  productUsed      String
  quantity         String
  notes            String?
  createdBy        String?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  activityType     ActivityType @relation(fields: [activityTypeId], references: [id])
  createdByUser    User?        @relation(fields: [createdBy], references: [id])
  farm             Farm?        @relation(fields: [farmId], references: [id])

  @@index([farmId])
  @@index([date])
  @@index([activityTypeId])
}

model SoilAnalysis {
  id                String   @id @default(uuid())
  farmId            String
  farmPlotLocation  String
  testDate          DateTime
  labName           String?
  certificateNumber String?
  pH                Float
  phosphorus        Float
  potassium         Float
  nitrogen          Float
  calcium           Float
  magnesium         Float
  organicMatter     Float?
  sulfur            Float?
  zinc              Float?
  iron              Float?
  manganese         Float?
  copper            Float?
  boron             Float?
  notes             String?
  recommendations   String?
  createdBy         String
  createdByRole     UserRole
  attachmentUrl     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  createdByUser     User     @relation(fields: [createdBy], references: [id])
  farm              Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@index([farmId])
  @@index([testDate])
}

model WeatherRecord {
  id               String        @id @default(uuid())
  farmId           String
  farmPlotLocation String
  recordDate       DateTime
  temperatureMin   Float
  temperatureMax   Float
  temperatureAvg   Float
  rainfall         Float
  humidity         Float
  source           WeatherSource @default(Manual)
  notes            String?
  recordedBy       String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  farm             Farm          @relation(fields: [farmId], references: [id], onDelete: Cascade)
  recordedByUser   User?         @relation(fields: [recordedBy], references: [id])

  @@index([farmId])
  @@index([recordDate])
}

model CuppingSession {
  id           String                @id @default(uuid())
  name         String
  date         DateTime              @default(now())
  type         CuppingSessionType
  status       CuppingSessionStatus  @default(Setup)
  finalResults Json?
  createdBy    String
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  samples      CuppingSample[]
  creator      User                  @relation("SessionCreator", fields: [createdBy], references: [id])
  judges       CuppingSessionJudge[]
  scores       JudgeScore[]

  @@index([date])
  @@index([status])
}

model CuppingSample {
  id               String         @id @default(uuid())
  cuppingSessionId String
  blindCode        String
  greenBeanLotId   String?
  submitterInfo    Json
  originInfo       Json
  lotInfo          Json
  createdAt        DateTime       @default(now())
  cuppingSession   CuppingSession @relation(fields: [cuppingSessionId], references: [id], onDelete: Cascade)
  greenBeanLot     GreenBeanLot?  @relation(fields: [greenBeanLotId], references: [id])
  scores           JudgeScore[]

  @@index([cuppingSessionId])
  @@index([blindCode])
}

model CuppingSessionJudge {
  id               String         @id @default(uuid())
  cuppingSessionId String
  judgeId          String
  judgeName        String
  judgeRole        UserRole
  createdAt        DateTime       @default(now())
  cuppingSession   CuppingSession @relation(fields: [cuppingSessionId], references: [id], onDelete: Cascade)
  judge            User           @relation(fields: [judgeId], references: [id])

  @@unique([cuppingSessionId, judgeId])
  @@index([cuppingSessionId])
}

model JudgeScore {
  id               String         @id @default(uuid())
  cuppingSessionId String
  sampleId         String
  judgeId          String
  judgeName        String
  scores           Json
  notes            String
  totalScore       Float
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  cuppingSession   CuppingSession @relation(fields: [cuppingSessionId], references: [id], onDelete: Cascade)
  judge            User           @relation(fields: [judgeId], references: [id])
  sample           CuppingSample  @relation(fields: [sampleId], references: [id], onDelete: Cascade)

  @@unique([cuppingSessionId, sampleId, judgeId])
  @@index([cuppingSessionId])
  @@index([sampleId])
  @@index([judgeId])
}

model CuppingScore {
  id             String       @id @default(uuid())
  greenBeanLotId String
  sessionId      String
  score          Float
  createdAt      DateTime     @default(now())
  greenBeanLot   GreenBeanLot @relation(fields: [greenBeanLotId], references: [id], onDelete: Cascade)

  @@unique([greenBeanLotId, sessionId])
  @@index([greenBeanLotId])
  @@index([sessionId])
}

model RoasterInventoryItem {
  id                String       @id @default(uuid())
  roasterId         String
  greenBeanLotId    String
  claimedWeightKg   Float
  remainingWeightKg Float
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  roastBatches      RoastBatch[]
  greenBeanLot      GreenBeanLot @relation(fields: [greenBeanLotId], references: [id])
  roaster           User         @relation(fields: [roasterId], references: [id], onDelete: Cascade)

  @@unique([roasterId, greenBeanLotId])
  @@index([roasterId])
}

model RoastBatch {
  id                 String               @id @default(uuid())
  roasterId          String
  roasterInventoryId String
  greenBeanLotId     String
  roastDate          DateTime             @default(now())
  batchSizeKg        Float
  yieldPercentage    Float
  roastedWeightKg    Float?
  weightLossPct      Float?
  roastLevel         RoastLevel?
  roastProfileNotes  String
  flavorNotes        String?
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  greenBeanLot       GreenBeanLot         @relation(fields: [greenBeanLotId], references: [id])
  roaster            User                 @relation(fields: [roasterId], references: [id])
  roasterInventory   RoasterInventoryItem @relation(fields: [roasterInventoryId], references: [id])

  @@index([roasterId])
  @@index([roastDate])
}

model Customer {
  id           String       @id @default(uuid())
  name         String
  type         CustomerType
  contactEmail String?
  contactPhone String?
  address      String?
  notes        String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  saleOrders   SaleOrder[]

  @@index([type])
}

model SaleOrder {
  id           String          @id @default(uuid())
  orderNumber  String          @unique
  customerId   String
  customerName String
  orderDate    DateTime        @default(now())
  status       SaleOrderStatus @default(Draft)
  totalAmount  Float
  currency     String
  notes        String?
  createdBy    String
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  invoices     Invoice[]
  creator      User            @relation(fields: [createdBy], references: [id])
  customer     Customer        @relation(fields: [customerId], references: [id])
  items        SaleOrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([orderDate])
}

model SaleOrderItem {
  id             String       @id @default(uuid())
  saleOrderId    String
  greenBeanLotId String
  lotGrade       String
  quantity       Float
  pricePerKg     Float
  subtotal       Float
  createdAt      DateTime     @default(now())
  greenBeanLot   GreenBeanLot @relation(fields: [greenBeanLotId], references: [id])
  saleOrder      SaleOrder    @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)

  @@index([saleOrderId])
  @@index([greenBeanLotId])
}

model Invoice {
  id            String        @id @default(uuid())
  invoiceNumber String        @unique
  saleOrderId   String
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  status        InvoiceStatus @default(Draft)
  subtotal      Float
  tax           Float?
  totalAmount   Float
  currency      String
  notes         String?
  createdBy     String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  creator       User          @relation(fields: [createdBy], references: [id])
  saleOrder     SaleOrder     @relation(fields: [saleOrderId], references: [id])
  items         InvoiceItem[]

  @@index([saleOrderId])
  @@index([status])
  @@index([issueDate])
}

model InvoiceItem {
  id             String       @id @default(uuid())
  invoiceId      String
  greenBeanLotId String
  lotGrade       String
  quantity       Float
  pricePerKg     Float
  subtotal       Float
  createdAt      DateTime     @default(now())
  greenBeanLot   GreenBeanLot @relation(fields: [greenBeanLotId], references: [id])
  invoice        Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([greenBeanLotId])
}

model PricingHistory {
  id             String       @id @default(uuid())
  greenBeanLotId String
  pricePerKg     Float
  currency       String
  effectiveDate  DateTime     @default(now())
  setBy          String
  notes          String?
  createdAt      DateTime     @default(now())
  greenBeanLot   GreenBeanLot @relation(fields: [greenBeanLotId], references: [id], onDelete: Cascade)
  setter         User         @relation(fields: [setBy], references: [id])

  @@index([greenBeanLotId])
  @@index([effectiveDate])
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  used      Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([userId])
  @@index([expiresAt])
}

enum UserRole {
  Farmer
  Processor
  Roaster
  HeadJudge
  Cupper
  Admin
}

enum ProcessingBatchStatus {
  ToProcess
  Drying
  Completed
}

enum HarvestLotStatus {
  ReadyForProcessing
  Complete
}

enum ParchmentLotStatus {
  AwaitingHulling
  Hulled
}

enum ParchmentSourceType {
  Internal
  External
}

enum GreenBeanSourceType {
  Internal
  External
}

enum GreenBeanAvailabilityStatus {
  Available
  Withdrawn
}

enum WithdrawalType {
  Sale
  RoastingStock
  Sample
  Export
  Other
}

enum ParchmentWithdrawalType {
  Sale
  RoastingStock
  HullAndGrade
  Sample
  Export
  Other
}

enum CuppingSessionType {
  QC
  Competition
}

enum CuppingSessionStatus {
  Setup
  Scoring
  Adjudication
  Finalized
}

enum SaleOrderStatus {
  Draft
  Confirmed
  Delivered
  Cancelled
}

enum InvoiceStatus {
  Draft
  Sent
  Paid
  Overdue
}

enum CustomerType {
  Roaster
  Distributor
  Retailer
  Other
}

enum WeatherSource {
  Manual
  API
}

enum RoastLevel {
  Light
  Medium
  Dark
}

model FarmCollaborator {
  id        String   @id @default(uuid())
  farmId    String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  farm      Farm     @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user      User     @relation("CollaboratorUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
  @@index([farmId])
  @@index([userId])
}
